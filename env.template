# ============================================
# Deep Research Agent - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# 🆓 FREE API Keys (REQUIRED - No rate limits!)
# ============================================
# Get free API key from: https://console.groq.com (UNLIMITED free requests!)
GROQ_API_KEY=your-groq-api-key-here

# Get free API key from: https://openrouter.ai (FREE tier with multiple models!)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Get free API key from: https://tavily.com (1000 free requests/month)
TAVILY_API_KEY=your-tavily-api-key-here

# ============================================
# 💰 Optional API Keys (Leave empty if not using)
# ============================================
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPER_API_KEY=

# ============================================
# 📊 Optional Monitoring (Free tier available)
# ============================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-agent
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================
# Application Configuration
# ============================================
DEBUG=true
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:8501"]
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
MAX_RESEARCH_DEPTH=3
DEFAULT_SEARCH_RESULTS=5
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

